# Copia este archivo a .env.local para desarrollo local.
# En Azure App Service, estas mismas claves se configuran en
# Configuration → Application Settings (ver src/DESPLIEGUE_APP_SERVICE.md).

# Autenticación: Azure App Service Easy Auth (Entra ID) — se configura
# en el Portal (App Service → Autenticación), no con env vars acá. Ver
# src/DESPLIEGUE_EASY_AUTH.md.

# Email
SENDGRID_API_KEY=
EMAIL_FROM=noreply@empresa.com

# SharePoint / OneDrive
NEXT_PUBLIC_SHAREPOINT_SITE=

# Dataverse (tabla cre47_comunicaciondecampana) — auth ROPC (usuario/
# contraseña de servicio + App Registration pública, sin client secret).
# Pendiente confirmar cuál de las 2 URLs es la real (mafperutst vs
# mafperutest) antes de completar esto. Mientras no estén, dejar vacío —
# el sync a Dataverse falla en silencio (queda logueado en consola) y no
# bloquea la creación local de campañas.
DATAVERSE_URL=
DATAVERSE_TENANT=common
DATAVERSE_APP_ID=
DATAVERSE_USERNAME=
DATAVERSE_PASSWORD=
